# ── LLM + Embeddings ──────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Document Parsing ──────────────────────────────────────────
# Get free key at: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-...

# ── Reranker ──────────────────────────────────────────────────
# Get free key at: https://dashboard.cohere.com
COHERE_API_KEY=...

# ── Vector Database ───────────────────────────────────────────
# Local Docker (default): http://localhost:6333
# Qdrant Cloud: https://<cluster-id>.aws.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                  # leave blank for local Docker
QDRANT_COLLECTION_NAME=company_docs

# ── Observability (Langfuse) ──────────────────────────────────
# Traces the whole LlamaIndex pipeline: intent routing, hybrid retrieval,
# AutoMerging, Cohere rerank, and response synthesis — inputs, outputs,
# latency, and token usage per step.
#
# Sign up free at https://cloud.langfuse.com, create a project, then
# Settings → API Keys. Leave LANGFUSE_ENABLED=false until you have keys —
# tracing is a no-op while it's off.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region (default). US: https://us.cloud.langfuse.com
# Self-hosted: your own base URL.
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Observability (LangSmith — DEPRECATED, inactive) ──────────
# LangSmith's auto-tracing instruments LangChain runnables. This project is
# LlamaIndex-only, so these variables capture nothing. Left here (commented)
# only so existing .env files keep working. Use LANGFUSE_* above instead.
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=rag-internal-docs

# ── Auth / JWT ────────────────────────────────────────────────
# REQUIRED. The value below is a public placeholder — it is committed to this
# repository, so leaving it in place means anyone who has read the repo can
# forge a token for any role, including admin, which bypasses RBAC entirely.
# The app refuses to start with it.
#
# Generate your own:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# To skip this for local development or CI, where the placeholder is harmless,
# set ALLOW_INSECURE_AUTH=true instead of weakening the check.
JWT_SECRET=change-me-in-production-use-secrets-token-hex-32

# REQUIRED for any reachable deployment. Every demo account in
# auth/jwt_handler.py shares this password, `admin` included — leaving it at
# "secret" means anyone can simply log in as an administrator. A strong
# JWT_SECRET prevents forged tokens but does nothing about a genuine login.
#
# Generate your own:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
DEMO_USER_PASSWORD=secret

# Accepts the placeholder credentials above. Local development and CI only —
# never set this on anything reachable. (ALLOW_INSECURE_JWT_SECRET is still
# honoured as a deprecated alias.)
# ALLOW_INSECURE_AUTH=true
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480     # 8 hours

# All demo users share DEMO_USER_PASSWORD above. For anything beyond a demo,
# replace the _DEMO_USERS dict in auth/jwt_handler.py with real DB/IdP lookups.

# ── Event-driven ingestion ─────────────────────────────────────
# Redis job queue (used by ARQ worker)
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_S=30

# ── Webhook HMAC secrets ───────────────────────────────────────
# Copy the value you set in each provider's webhook configuration UI.
# Leave blank to skip signature verification (local dev only).
#
# Confluence: Settings → System → Webhooks → Secret
WEBHOOK_SECRET_CONFLUENCE=
# SharePoint: Subscription clientState value (treat as shared secret)
WEBHOOK_SECRET_SHAREPOINT=
# Google Drive: Push notification channel token
WEBHOOK_SECRET_GDRIVE=

# ── Semantic cache ────────────────────────────────────────────
# Set to false to disable (useful during development)
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity threshold for a cache hit (0.0–1.0)
# 0.92 catches paraphrases; raise toward 0.99 for exact-only matching
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
# How long a cache entry lives before automatic expiry (seconds)
SEMANTIC_CACHE_TTL_SECONDS=86400
# Max entries per (role, dept_filter) namespace before LRU eviction
SEMANTIC_CACHE_MAX_ENTRIES=10000
# Flush entire cache after every document ingest event
INVALIDATE_CACHE_ON_INGEST=false

# ── App Settings ──────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
TOP_K_RETRIEVAL=10          # candidates fetched from vector store
TOP_N_RERANK=3              # docs kept after reranking
HYBRID_ALPHA=0.5            # 0 = pure BM25, 1 = pure vector
CHUNK_SIZES=2048,512,128    # parent,child,leaf node sizes

# ── Multimodal processing ──────────────────────────────────────
# Set to false to skip table + image processing (saves API cost)
ENABLE_MULTIMODAL=true
# Model for VLM calls (must support vision). gpt-4o-mini is cheaper.
VLM_MODEL=gpt-4o-mini
# Max chars of surrounding text sent to VLM as context
MULTIMODAL_CONTEXT_WINDOW=500
# Images larger than this many MB are skipped
MULTIMODAL_MAX_IMAGE_MB=4.0

# ── Agentic router ────────────────────────────────────────────────
# Fast cheap model for intent classification (adds ~100ms per query)
ROUTER_MODEL=gpt-4o-mini
# How many previous turns to include in conversation context
CONVERSATION_MEMORY_TURNS=6
# Max concurrent sessions kept in memory
CONVERSATION_MAX_SESSIONS=1000

# ── API ───────────────────────────────────────────────────────
# Browser origins allowed to call the API (comma-separated). This was "*",
# which let any page a user visits call the API with their token. Set this to
# the deployed UI's origin.
CORS_ALLOWED_ORIGINS=http://localhost:8501

API_HOST=0.0.0.0
API_PORT=8000
